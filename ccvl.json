{
  "format": "ccvl-workspace",
  "schema_version": 2,
  "application_schema": "schemas/application.schema.json",
  "profile_schema": "schemas/profile.schema.json",
  "applications": {
    "root": "applications",
    "filename": "application.json"
  },
  "skills": [
    "ccvl-install",
    "ccvl-profile",
    "ccvl-targets",
    "ccvl-cv",
    "ccvl-apply",
    "ccvl-interview",
    "ccvl-upskill",
    "ccvl-outcome"
  ],
  "showcase": {
    "profile": "showcase/profile.json",
    "de-CH": "showcase/de-ch/application.json",
    "en-CH": "showcase/en-ch/application.json"
  },
  "documents": {
    "cv": {
      "de-CH": "cvl/cv/de-ch/main.typ",
      "en-CH": "cvl/cv/en-ch/main.typ",
      "presets": [2, 3, 4],
      "summary_lines": 5
    },
    "cover_letter": {
      "de-CH": "cvl/cl/de-ch/main.typ",
      "en-CH": "cvl/cl/en-ch/main.typ",
      "paragraphs": 5,
      "highlights": 5,
      "body_lines": { "minimum": 14, "target": 15, "maximum": 16 },
      "line_regions": [
        { "paragraphs": [1, 2, 3], "minimum": 8, "target": 9, "maximum": 10 },
        { "paragraphs": [4, 5], "minimum": 5, "target": 6, "maximum": 7 }
      ],
      "vertical_rhythm": {
        "gap_pt": { "minimum": 30, "target": 45, "maximum": 55 },
        "highlight_center_percent": { "minimum": 56, "target": 61, "maximum": 67 }
      }
    }
  }
}
