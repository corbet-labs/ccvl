{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/corbet-labs/ccvl/raw/main/.agent/schemas/profile.schema.json",
  "title": "ccvl public profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "name", "email", "phone_label", "phone_href",
    "location", "languages", "linkedin", "website", "localized"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string" },
    "email": { "type": "string" },
    "phone_label": { "type": "string" },
    "phone_href": { "type": "string" },
    "location": { "type": "string" },
    "languages": { "type": "string" },
    "linkedin": { "type": "string" },
    "website": { "type": "string" },
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["de-CH", "en-CH"],
      "properties": {
        "de-CH": { "$ref": "#/$defs/localizedProfile" },
        "en-CH": { "$ref": "#/$defs/localizedProfile" }
      }
    }
  },
  "$defs": {
    "localizedProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nationality_and_permit", "availability"],
      "properties": {
        "nationality_and_permit": { "type": "string" },
        "availability": { "type": "string" }
      }
    }
  }
}
