#!/usr/bin/env bash
set -euo pipefail

repo_root="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export PATH="$repo_root/.cache/ccvl/bin:$PATH"
export UV_PROJECT_ENVIRONMENT="$repo_root/.cache/ccvl/venv"
export UV_CACHE_DIR="$repo_root/.cache/ccvl/uv-cache"
export UV_PYTHON_INSTALL_DIR="$repo_root/.cache/ccvl/python"
python_version="$(<"$repo_root/.python-version")"

usage() {
  cat <<'EOF'
Usage: bash ./ccvl <command> [arguments]

  setup                              Install missing tools locally and verify ccvl
  bootstrap                          Show the setup plan without changing anything
  doctor                             Report installed and missing tools
  check                              Run all deterministic checks
  public-check                       Run checks required before publication
  build                              Build every showcase document
  build-cv <locale> [pages]          Build one CV (default: four pages)
  build-cl <locale>                  Build one cover letter
  build-application <json> <locale> [pages]
                                     Build a private application package
  help                               Show this help
EOF
}

run_python() {
  if ! command -v uv >/dev/null 2>&1; then
    printf 'uv is not available. Run bash ./ccvl setup first.\n' >&2
    return 2
  fi
  (cd "$repo_root" && uv run --frozen --no-dev --python "$python_version" python "$@")
}

command_name="${1:-help}"
shift || true
case "$command_name" in
  setup)
    bash "$repo_root/scripts/bootstrap.sh" install
    run_python "$repo_root/scripts/check.py"
    ;;
  bootstrap) bash "$repo_root/scripts/bootstrap.sh" plan "$@" ;;
  doctor) bash "$repo_root/scripts/doctor.sh" "$@" ;;
  check) run_python "$repo_root/scripts/check.py" "$@" ;;
  public-check) run_python "$repo_root/scripts/public_check.py" "$@" ;;
  build) run_python "$repo_root/scripts/render.py" all "$@" ;;
  build-cv)
    [[ $# -ge 1 && $# -le 2 ]] || { usage >&2; exit 2; }
    run_python "$repo_root/scripts/render.py" cv "$1" "${2:-4}"
    ;;
  build-cl)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    run_python "$repo_root/scripts/render.py" cl "$1"
    ;;
  build-application)
    [[ $# -ge 2 && $# -le 3 ]] || { usage >&2; exit 2; }
    run_python "$repo_root/scripts/render.py" application "$1" "$2" "${3:-4}"
    ;;
  help | -h | --help) usage ;;
  *)
    printf 'Unknown command: %s\n\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac
