{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/corbet-labs/ccvl/raw/main/.agent/schemas/application.schema.json",
  "title": "ccvl application",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "job", "tailored_cv", "tailored_cl"],
  "properties": {
    "schema_version": { "const": 4 },
    "revision": { "type": "integer", "minimum": 0 },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "organization", "location", "source", "url", "language", "application_date",
        "description", "connections", "company_context", "notes", "cl_recipient"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]*$" },
        "title": { "type": "string" },
        "organization": { "type": "string" },
        "location": { "type": "string" },
        "source": { "type": "string" },
        "url": { "type": "string" },
        "language": { "type": "string", "enum": ["", "de-CH", "en-CH"] },
        "application_date": { "type": "string" },
        "description": { "type": "string" },
        "connections": { "type": "string" },
        "company_context": { "type": "string" },
        "notes": { "type": "string" },
        "cl_recipient": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "title", "company", "address_line_1", "address_line_2"],
          "properties": {
            "name": { "type": "string" },
            "title": { "type": "string" },
            "company": { "type": "string" },
            "address_line_1": { "type": "string" },
            "address_line_2": { "type": "string" }
          }
        }
      }
    },
    "tailored_cv": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pages", "summary"],
      "properties": {
        "pages": { "type": "integer", "minimum": 2, "maximum": 4 },
        "summary": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/lineContract" }
        }
      }
    },
    "tailored_cl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "paragraphs": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/paragraph" }
        },
        "highlights": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/lineContract" }
        }
      }
    }
  },
  "$defs": {
    "fillPercentage": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "lineContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "min_fill", "target_fill", "max_fill"],
      "properties": {
        "text": { "type": "string", "pattern": "^[^\\r\\n]*$" },
        "min_fill": { "$ref": "#/$defs/fillPercentage" },
        "target_fill": { "$ref": "#/$defs/fillPercentage" },
        "max_fill": { "$ref": "#/$defs/fillPercentage" }
      }
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lines"],
      "properties": {
        "lines": {
          "type": "array",
          "minItems": 2,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/lineContract" }
        }
      }
    }
  }
}
