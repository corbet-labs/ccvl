{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/corbet-labs/ccvl/raw/main/schemas/stations.schema.json",
  "title": "ccvl CV station plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated", "stations"],
  "properties": {
    "schema_version": { "const": 1 },
    "updated": { "type": "string", "pattern": "(?:|[0-9]{4}-[0-9]{2}-[0-9]{2})" },
    "stations": {
      "type": "array",
      "items": { "$ref": "#/$defs/station" }
    }
  },
  "$defs": {
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "label", "anchor", "kind", "status", "page", "section",
        "experience_eligible", "facts", "source_refs"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "[a-z0-9]+(?:[-_][a-z0-9]+)*" },
        "label": { "type": "string" },
        "anchor": { "type": "string" },
        "kind": {
          "enum": [
            "employment", "independent-work", "project", "research",
            "education", "professional-development", "engagement",
            "award", "publication", "personal-responsibility", "other"
          ]
        },
        "status": { "enum": ["verified", "conflicted", "unverified"] },
        "page": { "enum": [1, 2, null] },
        "section": { "type": "string" },
        "experience_eligible": { "type": "boolean" },
        "facts": {
          "type": "array",
          "items": { "$ref": "#/$defs/fact" }
        },
        "source_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string", "pattern": "[a-z0-9]+(?:[-_][a-z0-9]+)*" },
        "text": { "type": "string" }
      }
    }
  }
}
