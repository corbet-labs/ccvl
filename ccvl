#!/usr/bin/env bash
set -euo pipefail

repo_root="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export PATH="$repo_root/.cache/ccvl/bin:$PATH"

usage() {
  cat <<'EOF'
Usage: ./ccvl <command> [arguments]

  setup                              Install missing tools locally and verify ccvl
  bootstrap                          Show the setup plan without changing anything
  doctor                             Report installed and missing tools
  check                              Run all deterministic checks
  public-check                       Run checks required before publication
  build                              Build every showcase document
  build-cv <locale> [pages]          Build one CV (default: four pages)
  build-cl <locale>                  Build one cover letter
  build-application <json> <locale> [pages]
                                     Build a private application package
  help                               Show this help
EOF
}

command_name="${1:-help}"
shift || true
case "$command_name" in
  setup)
    bash "$repo_root/scripts/bootstrap.sh" install
    bash "$repo_root/scripts/check.sh"
    ;;
  bootstrap) bash "$repo_root/scripts/bootstrap.sh" plan "$@" ;;
  doctor) bash "$repo_root/scripts/doctor.sh" "$@" ;;
  check) bash "$repo_root/scripts/check.sh" "$@" ;;
  public-check) bash "$repo_root/scripts/public-check.sh" "$@" ;;
  build) bash "$repo_root/scripts/render.sh" all "$@" ;;
  build-cv)
    [[ $# -ge 1 && $# -le 2 ]] || { usage >&2; exit 2; }
    bash "$repo_root/scripts/render.sh" cv "$1" "${2:-4}"
    ;;
  build-cl)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    bash "$repo_root/scripts/render.sh" cl "$1"
    ;;
  build-application)
    [[ $# -ge 2 && $# -le 3 ]] || { usage >&2; exit 2; }
    bash "$repo_root/scripts/render.sh" application "$1" "$2" "${3:-4}"
    ;;
  help | -h | --help) usage ;;
  *)
    printf 'Unknown command: %s\n\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac
